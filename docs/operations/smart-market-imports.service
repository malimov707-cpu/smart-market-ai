# SHABLON: host yo‘llari/user va runtime.env operator tomonidan review qilinsin.
# Bu fayl o‘rnatilmadi yoki enable/start qilinmadi.
[Unit]
Description=Smart Market database import worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=smartmarket
Group=smartmarket
WorkingDirectory=/srv/smart-market/current
EnvironmentFile=/etc/smart-market/runtime.env
ExecStart=/usr/bin/php /srv/smart-market/current/artisan queue:work database --queue=imports --sleep=1 --timeout=60 --tries=3 --max-time=3600 --memory=256 --no-interaction
Restart=always
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=100
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/smart-market/shared
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
