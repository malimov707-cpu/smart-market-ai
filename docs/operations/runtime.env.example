# SHABLON: .env emas. /etc/smart-market/runtime.env operator yaratadi (0600).
# Missing secrets bu faylga yozilmadi; secret manager orqali yuborilsin.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.example.invalid
# APP_KEY: alohida mavjud staging key; production key hech qachon qayta yaratilmaydi.
DB_CONNECTION=pgsql
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/smart-market/db-ca.pem
# DB_HOST/PORT/DATABASE/USERNAME/PASSWORD: tashqi sozlama.
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
OPS_WORKER_HEARTBEAT_ENABLED=true
OPS_WORKER_HEARTBEAT_PATH=/srv/smart-market/shared/operations/import-worker-heartbeat.json
CATALOG_STORAGE_PATH=/srv/smart-market/shared/catalog-private
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_PORT=587
MAIL_TIMEOUT=15
# MAIL_HOST/USERNAME/PASSWORD/FROM_ADDRESS: verified sender + external secrets.
# MAIL_URL ishlatilmaydi; config review override’larni alohida tekshiradi.
# OPS_SMTP_TEST_RECIPIENTS faqat foydalanuvchi tasdiqlagan test manzillari.
IMPORT_AI_PROVIDER=unavailable
# AI yoqilishi uchun vendor-neutral gateway contractiga mos HTTPS endpoint/model/key.
# IMPORT_SCAN_REQUIRED=true faqat real FileScanner adapter provision qilingach;
# mavjud unavailable adapter bilan true processingni ataylab bloklaydi.
