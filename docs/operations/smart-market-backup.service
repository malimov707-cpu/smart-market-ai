# SHABLON: backup user faqat DB read + backup katalog write huquqiga ega bo‘lsin.
[Unit]
Description=Smart Market encrypted PostgreSQL backup
After=network-online.target

[Service]
Type=oneshot
User=smartmarket-backup
Group=smartmarket-backup
EnvironmentFile=/etc/smart-market/backup.env
ExecStart=/usr/local/libexec/smart-market-pg-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/smart-market
StandardOutput=journal
StandardError=journal
